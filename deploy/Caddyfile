# Build My AI — production reverse proxy (same-origin, automatic HTTPS).
# One domain serves the static frontend AND proxies /v1/* to the loopback-bound
# API; Caddy terminates TLS. This is the docs/20 §3.1 same-origin topology —
# with same-origin serving, the frontend's API constant resolves to '' and needs
# zero configuration.
#
# Before going live:
#   1. Replace buildmyai.example.com below with your real domain.
#   2. In frontend/sitemap.xml replace every https://__DOMAIN__ with the domain,
#      and uncomment the `Sitemap:` line in frontend/robots.txt.
#   3. Inject a real BMA_ADMIN_SECRET into the API service.
# See deploy/README.md for the full runbook.

buildmyai.example.com {
	encode gzip zstd

	# --- security headers (docs/19: CSP + transport hardening) ---
	header {
		# default-src 'self': only our own origin by default.
		# script/style 'unsafe-inline': the pages use inline onclick=setLang(...) and
		#   inline <script>/style="" — no remote scripts are ever loaded.
		# img 'self' data:: favicon.svg + data: URIs only.
		# connect-src: 'self' covers the same-origin /v1/* API; http://127.0.0.1:* and
		#   http://localhost:* are REQUIRED so local-llm.js can reach the visitor's own
		#   local model engine (Ollama :11434 / llm-lab :8080/:8090) from chat/build.
		#   Browsers treat http://127.0.0.1|localhost as secure, so this isn't mixed content.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		X-Frame-Options "DENY"
		Permissions-Policy "geolocation=(), microphone=(), camera=()"
		-Server
	}

	# --- API: TLS terminates here, forward to the loopback-bound backend ---
	handle /v1/* {
		reverse_proxy 127.0.0.1:8940
	}

	# --- static site ---
	handle {
		root * /srv/buildmyai/frontend
		file_server
	}
}
