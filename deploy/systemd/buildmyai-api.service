# Build My AI — API service (zero-dependency stdlib server, loopback-bound).
# Install: copy to /etc/systemd/system/, edit the Environment= lines, then
#   sudo systemctl daemon-reload && sudo systemctl enable --now buildmyai-api
# The reverse proxy (deploy/Caddyfile or nginx.conf) fronts this with TLS.
[Unit]
Description=Build My AI API (v0)
After=network.target

[Service]
Type=simple
User=bma
Group=bma
WorkingDirectory=/srv/buildmyai
# --- required: inject a real secret (the default refuses a non-loopback bind and
#     is unsafe anywhere — it can mint licenses). Keep the API on 127.0.0.1. ---
Environment=BMA_LICENSE_SECRET=CHANGE_ME_INJECT_A_REAL_SECRET
# --- billing (leave empty to keep checkout/portal honestly 503 until you go live) ---
Environment=BMA_STRIPE_SECRET=
Environment=BMA_STRIPE_WEBHOOK_SECRET=
Environment=BMA_STRIPE_PRICE_PRO=
Environment=BMA_STRIPE_PRICE_BUSINESS=
Environment=BMA_CHECKOUT_SUCCESS_URL=https://buildmyai.example.com/checkout-success.html
Environment=BMA_CHECKOUT_CANCEL_URL=https://buildmyai.example.com/checkout-cancel.html
Environment=BMA_PORTAL_RETURN_URL=https://buildmyai.example.com/dashboard.html
# --- email (unset => dev/stdout; point BMA_SMTP_* at Amazon SES SMTP for real mail) ---
Environment=BMA_SITE_URL=https://buildmyai.example.com
Environment=BMA_MAIL_FROM=Build My AI <no-reply@buildmyai.example.com>
Environment=BMA_SMTP_HOST=
Environment=BMA_SMTP_USER=
Environment=BMA_SMTP_PASS=
# --- structured logs on (captured by journald); alerting pipeline trips on level ---
Environment=BMA_LOG=1
ExecStart=/usr/bin/python3 /srv/buildmyai/backend/api/server.py --port 8940 --host 127.0.0.1
Restart=on-failure
RestartSec=2

# --- sandboxing: the process only needs to write its two SQLite dbs ---
# ReadWritePaths must already exist (ProtectSystem=strict makes its parent
# read-only, so the server can't create it): mkdir -p it as user bma first.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/buildmyai/backend/api/data
# Extra hardening — all safe for a pure-stdlib CPython HTTP server (no device
# access, no kernel tuning, no privilege changes; it still needs IPv4/IPv6 for
# the reverse proxy + outbound Stripe/SMTP, and AF_UNIX for DNS/journald).
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
