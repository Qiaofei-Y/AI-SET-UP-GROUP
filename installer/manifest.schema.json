{
  "_comment": "Contract for the wizard's install-plan.json (produced by frontend/assets/build.js installManifest()) — the same document the batch-2 desktop installer will consume. A lightweight, zero-dependency shape spec (JSON-Schema subset understood by frontend/tests/security.test.js §8c). Keep this and installManifest() in lockstep: the test fails if they drift.",
  "version": 1,
  "type": "object",
  "required": ["product", "generated", "need", "mode", "install_method", "target", "plan"],
  "properties": {
    "product": { "type": "string" },
    "generated": { "type": "string" },
    "need": { "type": "string" },
    "mode": { "type": "string", "enum": ["local", "cloud", "hybrid"] },
    "install_method": { "type": "string", "enum": ["ollama_guided", "cloud_manual"] },
    "target": {
      "type": "object",
      "required": ["os", "gpu", "vram_gb", "ram_gb"],
      "properties": {
        "os": { "type": "string" },
        "gpu": { "type": "string" },
        "vram_gb": { "type": "number" },
        "ram_gb": { "type": "number" }
      }
    },
    "plan": {
      "type": "object",
      "required": ["model", "quant", "model_file", "source", "approx_size", "runtime", "api", "rag"],
      "properties": {
        "model": { "type": "string" },
        "quant": { "type": "string" },
        "model_file": { "type": "string" },
        "source": { "type": "string" },
        "approx_size": { "type": "string" },
        "runtime": { "type": "string" },
        "ollama_tag": { "type": ["string", "null"] },
        "api": { "type": "string" },
        "rag": {
          "type": "object",
          "required": ["enabled", "planned", "note"],
          "properties": {
            "enabled": { "type": "boolean" },
            "planned": { "type": "boolean" },
            "note": { "type": "string" }
          }
        }
      }
    }
  }
}
